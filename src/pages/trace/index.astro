---
import Layout from '../../layouts/Layout.astro';
import {
  u, BASE, getAttestations, getTraceLedger, gradeColor, categoryLabel, NEUTRAL} from '../../lib/data.mjs';

const attestations = [...getAttestations()].sort((a, b) => a.source_id.localeCompare(b.source_id));
const ledger = getTraceLedger();
const superseded = ledger.filter((r) => !attestations.some((a) => a.trace_id === r.trace_id));
const MONO = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
const PUBLIC_URL = (process.env.MODAFIED_PUBLIC_URL ?? 'https://alexchouck-hash.github.io/modafied-site')
  .replace(/^https?:\/\//, '')
  .replace(/\/$/, '');
---

<Layout title="Trace an emblem">
  <div style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem;">Trace an emblem</h1>
    <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 820px;">
      Every Modafied emblem prints a trace id on its face. Type it into
      {' '}<code>{PUBLIC_URL}/trace/&lt;id&gt;</code>{' '}
      and you get the exact claim that emblem was making, the scorecard digest it was derived from, the method
      and band table versions that produced it, and every claim that emblem has made before.
    </p>
    <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 820px; margin-top: 0.75rem;">
      This exists because an emblem is usually seen somewhere we do not control — a provider listing, a README,
      a slide. A badge you cannot trace is decoration. A badge you can trace is evidence.
    </p>
  </div>

  <section style="border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem;">Look up a trace id</h2>
    <form id="trace-form" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <input
        id="trace-input"
        name="trace"
        placeholder="e.g. 07b2f3a9567b"
        pattern="[0-9a-fA-F]{12}"
        required
        style={`flex: 1 1 260px; padding: 0.6rem 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-family: ${MONO}; font-size: 0.95rem; background: var(--bg-color); color: var(--text-color);`}
      />
      <button type="submit" style="padding: 0.6rem 1.1rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--primary-color); color: #fff; font-weight: 600; cursor: pointer;">
        Resolve
      </button>
    </form>
    <p id="trace-error" hidden style="color: #b91c1c; font-size: 0.9rem; margin-top: 0.6rem;">
      A trace id is 12 hexadecimal characters, printed on the emblem.
    </p>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.75rem;">
      No lookup is recorded. This form only builds a URL; the page it opens is static like every other page here.
    </p>
  </section>

  <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.75rem;">Currently live</h2>
  <p style="color: var(--text-muted); margin-bottom: 1rem;">
    What each feed's emblem claims right now. These ids change when, and only when, the measurement changes.
  </p>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 2.5rem; font-size: 0.92rem;">
    <thead>
      <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
        <th style="padding: 0.5rem 0;">Feed</th>
        <th style="padding: 0.5rem 0;">Category</th>
        <th style="padding: 0.5rem 0;">Claim</th>
        <th style="padding: 0.5rem 0;">Trace</th>
      </tr>
    </thead>
    <tbody>
      {attestations.map((a) => {
        const ok = a.claim.status === 'ok';
        const color = ok ? gradeColor(a.claim.grade) : NEUTRAL;
        return (
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.6rem 0;"><a href={u(`/scorecards/${a.source_id}`)}>{a.source_name}</a></td>
            <td style="padding: 0.6rem 0; color: var(--text-muted);">{categoryLabel(a.category)}</td>
            <td style="padding: 0.6rem 0;">
              <span class="badge" style={`background-color: ${color.bg}; color: ${color.fg}; border-color: transparent;`}>
                {ok ? `${a.claim.grade} · ${a.claim.points} pts` : 'insufficient data'}
              </span>
            </td>
            <td style={`padding: 0.6rem 0; font-family: ${MONO};`}><a href={u(`/trace/${a.trace_id}`)}>{a.trace_id}</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>

  {superseded.length > 0 && (
    <>
      <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.75rem;">Superseded claims</h2>
      <p style="color: var(--text-muted); margin-bottom: 1rem; max-width: 820px;">
        Claims we no longer make, kept resolvable because emblems carrying them may still be in circulation.
        Nothing here is deleted when a grade falls; that is the point of keeping it.
      </p>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2.5rem; font-size: 0.92rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
            <th style="padding: 0.5rem 0;">Trace</th>
            <th style="padding: 0.5rem 0;">Feed</th>
            <th style="padding: 0.5rem 0;">Claimed</th>
            <th style="padding: 0.5rem 0;">From</th>
          </tr>
        </thead>
        <tbody>
          {superseded.map((r) => (
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style={`padding: 0.6rem 0; font-family: ${MONO};`}><a href={u(`/trace/${r.trace_id}`)}>{r.trace_id}</a></td>
              <td style="padding: 0.6rem 0;">{r.source_id}</td>
              <td style="padding: 0.6rem 0;">
                {r.status === 'ok' ? `${r.grade} · ${r.points} pts · ${r.graded_dimensions}/6` : `insufficient data · ${r.graded_dimensions}/6`}
              </td>
              <td style="padding: 0.6rem 0; color: var(--text-muted);">{r.observed_at}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <section style="border: 1px solid var(--border-color); border-left: 3px solid var(--primary-color); border-radius: 6px; padding: 1.25rem; background: var(--bg-subtle);">
    <h2 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem;">Verifying without trusting us either</h2>
    <ol style="color: var(--text-muted); font-size: 0.93rem; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem;">
      <li>Read the trace id off the emblem, or out of its SVG <code>&lt;metadata id="modafied-trace"&gt;</code> block.</li>
      <li>Fetch <code>/v1/emblems/&lt;source&gt;.json</code> and confirm its <code>trace_id</code> matches what the emblem shows. If it does not, the emblem is stale or self hosted, which E2 forbids.</li>
      <li>Fetch the scorecard named in <code>evidence.scorecard_json_url</code>, hash the bytes, and compare with <code>evidence.scorecard_sha256</code>.</li>
      <li>Confirm that digest appears in <a href={u('/v1/manifest.json')}>manifest.json</a>, and pin the manifest hash.</li>
      <li>Re run the whole thing yourself: <code>make reproduce SOURCE=&lt;id&gt; AS_OF=&lt;ts&gt;</code> against the public archive.</li>
    </ol>
  </section>

  <script is:inline define:vars={{ base: BASE }}>
    (function () {
      var form = document.getElementById('trace-form');
      var input = document.getElementById('trace-input');
      var error = document.getElementById('trace-error');
      if (!form || !input || !error) return;
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var value = String(input.value || '').trim().toLowerCase();
        if (!/^[0-9a-f]{12}$/.test(value)) {
          error.hidden = false;
          return;
        }
        error.hidden = true;
        window.location.href = base + '/trace/' + value;
      });
    })();
  </script>
</Layout>
