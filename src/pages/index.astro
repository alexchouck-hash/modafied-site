---
import Layout from '../layouts/Layout.astro';
import {
  u,
  getRatings,
  getCatalogMap,
  getRankings,
  getRankPositions,
  gradeColor,
  categoryLabel,
  NEUTRAL,} from '../lib/data.mjs';

const catalog = getCatalogMap();
const positions = getRankPositions();
const rankings = getRankings();

const ratings = [...getRatings()].sort((a, b) => {
  const pa = a.composite.status === 'ok' ? -a.composite.points : 99;
  const pb = b.composite.status === 'ok' ? -b.composite.points : 99;
  return pa - pb || a.source_id.localeCompare(b.source_id);
});

const rated = ratings.filter((r) => r.composite.status === 'ok').length;
const categoriesWithContest = rankings.categories.filter((c) => c.ranked.length > 1).length;
---

<Layout title="Public Benchmark of Data Sources">
  <section style="margin-bottom: 3rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; line-height: 1.25; margin-bottom: 1rem;">
      Modafied: Independent Data Benchmarks for Apps and Agents
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 780px; margin-bottom: 1.5rem;">
      Modafied snapshots public feeds on a schedule, preserves every snapshot forever, diffs them, and publishes a
      six-dimension scorecard per source with the exact method and version. Feeds compete only against feeds in
      their own category, and no placement, grade, or emblem is purchasable.
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href={u('/rankings')} style="background-color: var(--primary-color); color: white; padding: 0.65rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
        See the rankings
      </a>
      <a href={u('/method')} style="background-color: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-color); padding: 0.65rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
        Read the method
      </a>
      <a href={u('/submit')} style="background-color: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-color); padding: 0.65rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
        Submit a feed
      </a>
    </div>
  </section>

  <section style="margin-bottom: 3.5rem;">
    <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700;">Every feed in the catalog</h2>
      <span style="font-size: 0.85rem; color: var(--text-muted);">
        {ratings.length} source{ratings.length === 1 ? '' : 's'} · {rated} currently rateable ·
        {' '}{rankings.categories.length} categories · {categoriesWithContest} contested
      </span>
    </div>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; max-width: 780px;">
      A grade is the mean of the dimensions we could actually measure, against the band table published on the
      <a href={u('/protocols')}>protocols page</a>. Where a feed has too little data, it says so instead of guessing.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
      {ratings.map((rating) => {
        const ok = rating.composite.status === 'ok';
        const color = ok ? gradeColor(rating.composite.grade) : NEUTRAL;
        const position = positions[rating.source_id];
        const source = catalog[rating.source_id] ?? {};
        return (
          <a href={u(`/scorecards/${rating.source_id}`)} style={`display: block; border: 1px solid var(--border-color); border-top: 4px solid ${color.solid}; border-radius: 8px; padding: 1.25rem; text-decoration: none; color: inherit; background: var(--bg-subtle);`}>
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;">
              <div>
                <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.2rem;">{rating.source_name}</h3>
                <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: capitalize;">
                  {categoryLabel(rating.category)}{position ? ` · rank ${position.rank} of ${position.of}` : ''}
                </div>
              </div>
              <div style={`font-size: 2rem; font-weight: 800; line-height: 1; color: ${color.solid};`}>
                {ok ? rating.composite.grade : '—'}
              </div>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.75rem 0;">
              {source.description ? source.description.slice(0, 110) + (source.description.length > 110 ? '…' : '') : ''}
            </p>
            <div style="font-size: 0.78rem; color: var(--text-muted);">
              {ok
                ? `${rating.composite.points.toFixed(2)} / 4.00 across ${rating.composite.graded_dimensions} of 6 dimensions`
                : `insufficient data · ${rating.composite.graded_dimensions} of 6 dimensions measurable`}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section style="margin-bottom: 3.5rem;">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Top of each category</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      {rankings.categories.map((category) => {
        const top = category.ranked[0];
        const color = top ? gradeColor(top.grade) : NEUTRAL;
        return (
          <a href={u(`/rankings/${category.category}`)} style="display: block; border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; text-decoration: none; color: inherit;">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 0.4rem;">
              {categoryLabel(category.category)}
            </div>
            {top ? (
              <>
                <div style="font-weight: 700; font-size: 1rem;">{top.source_name}</div>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                  <span style={`font-weight: 700; color: ${color.solid};`}>{top.grade}</span>
                  {' '}· {top.points.toFixed(2)} / 4.00 · {category.ranked.length === 1 ? 'only ranked feed so far' : `ahead of ${category.ranked.length - 1} other${category.ranked.length - 1 === 1 ? '' : 's'}`}
                </div>
              </>
            ) : (
              <div style="font-size: 0.85rem; color: var(--text-muted);">No feed here has enough data to rate yet.</div>
            )}
          </a>
        );
      })}
    </div>
  </section>

  <section style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">The Six Benchmark Dimensions</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      Every feed is evaluated mechanically against these dimensions:
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>1. Freshness Lag</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">p50 and p95 elapsed seconds between declared event time and ingest.</p>
      </div>
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>2. Revision Behavior</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Proportion of historical points updated post-publication.</p>
      </div>
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>3. Correction Latency</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Time elapsed before an erroneous or provisional value is corrected.</p>
      </div>
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>4. Completeness</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Non-null rate across declared fields and segments.</p>
      </div>
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>5. Schema Stability</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Structural payload consistency and field-level breaking changes.</p>
      </div>
      <div style="border: 1px solid var(--border-color); padding: 1rem; border-radius: 6px;">
        <strong>6. Internal Consistency</strong>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Cross-field sanity validation against declared domain bounds.</p>
      </div>
    </div>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 1rem;">
      Accuracy is published only where a named anchor exists, and it is never folded into the letter grade.
    </p>
  </section>
</Layout>
