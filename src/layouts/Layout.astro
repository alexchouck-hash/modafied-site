---
import { u } from '../lib/data.mjs';
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Modafied - Public Benchmark and Provenance Pipe for Data and Agents" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Modafied</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        --bg-color: #ffffff;
        --text-color: #111827;
        --text-muted: #4b5563;
        --border-color: #e5e7eb;
        --bg-subtle: #f9fafb;
        --primary-color: #1d4ed8;
        --primary-hover: #1e40af;
        --badge-bg: #eff6ff;
        --badge-text: #1e40af;
        --card-border: #e5e7eb;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        color: var(--text-color);
        background-color: var(--bg-color);
        line-height: 1.6;
        padding: 0;
      }

      header {
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-color);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .nav-container {
        max-width: 1024px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--text-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .brand span {
        font-size: 0.75rem;
        background-color: var(--badge-bg);
        color: var(--badge-text);
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-weight: 600;
      }

      nav {
        display: flex;
        gap: 1.25rem;
      }

      nav a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 500;
      }

      nav a:hover {
        color: var(--primary-color);
      }

      main {
        max-width: 1024px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      footer {
        border-top: 1px solid var(--border-color);
        background-color: var(--bg-subtle);
        padding: 2.5rem 1.5rem;
        margin-top: 4rem;
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      .footer-container {
        max-width: 1024px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      pre, code {
        font-family: var(--font-mono);
      }

      pre {
        background-color: #1e293b;
        color: #f8fafc;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.875rem;
        margin: 1rem 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.95rem;
      }

      th, td {
        border: 1px solid var(--border-color);
        padding: 0.75rem 1rem;
        text-align: left;
      }

      th {
        background-color: var(--bg-subtle);
        font-weight: 600;
      }

      .badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
        background-color: var(--bg-subtle);
        border: 1px solid var(--border-color);
      }

      @media (max-width: 640px) {
        .nav-container {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        nav {
          flex-wrap: wrap;
          gap: 0.85rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href={u('/')} class="brand">Modafied <span>Benchmark v0</span></a>
        <nav>
          <a href={u('/')}>Overview</a>
          <a href={u('/rankings')}>Rankings</a>
          <a href={u('/method')}>Methodology</a>
          <a href={u('/protocols')}>Protocols</a>
          <a href={u('/independence')}>Independence</a>
          <a href={u('/emblems')}>Emblems</a>
          <a href={u('/trace')}>Trace</a>
          <a href={u('/submit')}>Submit a feed</a>
          <a href={u('/status')}>Status</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <p><strong>Modafied</strong> is an independent, public, mechanically computed benchmark of data sources for apps and agents.</p>
        <p>All scorecards are computed mechanically from immutable snapshots. No manual overrides. No sponsored placement.</p>
        <p>
          Funded by Trooth, which is scored like everyone else and buys nothing with the money. The whole
          arrangement is written down on the <a href={u('/independence')}>independence page</a>.
        </p>
        <p>Emblems state a computed rating and nothing else. No emblem, placement, or rank is purchasable, at any price.</p>
        <p style="display: flex; flex-wrap: wrap; gap: 1rem;">
          <a href={u('/independence')}>Independence</a>
          <a href={u('/anchors')}>Anchors</a>
          <a href={u('/replicas')}>Replication</a>
          <a href={u('/disputes')}>Disputes</a>
          <a href={u('/contribute')}>Contribute</a>
        </p>
        <p>&copy; 2026 Modafied. Open contracts under permissive terms.</p>
      </div>
    </footer>
  </body>
</html>
